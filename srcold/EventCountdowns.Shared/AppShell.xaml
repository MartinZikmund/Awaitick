<Page
    x:Class="EventCountdowns.AppShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:EventCountdowns"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="TitleBarBorder" Background="{ThemeResource PageHeaderBackgroundBrush}" />
        <Frame
            x:Name="InnerFrame"
            Grid.Row="1"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
        <Button
            x:Name="BackButton"
            Grid.Row="1"
            VerticalAlignment="Top"
            IsEnabled="{x:Bind InnerFrame.CanGoBack, Mode=OneWay}"
            Style="{StaticResource NavigationBackButtonNormalStyle}"
            ToolTipService.ToolTip="Back"
            Visibility="{x:Bind ViewModel.BackButtonVisibility, Mode=OneWay}" />
    </Grid>
</Page>
