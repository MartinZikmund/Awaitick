<local:CountdownEditorViewBase
    x:Class="EventCountdowns.Views.CountdownEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:EventCountdowns.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:EventCountdowns.Core.Models"
    xmlns:usercontrols="using:EventCountdowns.Controls"
    xmlns:xaml="using:EventCountdowns.Extensions.Xaml"
    mc:Ignorable="d">
    <local:CountdownEditorViewBase.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition>
                <SuppressNavigationTransitionInfo />
            </NavigationThemeTransition>
        </TransitionCollection>
    </local:CountdownEditorViewBase.Transitions>
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <usercontrols:PageHeaderControl Title="{x:Bind Model.Title, Mode=OneWay}" FontWeight="SemiBold" />
        <ScrollViewer Grid.Row="1" Margin="0">
            <Border Padding="10" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            x:Name="WrapperGridMaxColumn"
                            Width="*"
                            MaxWidth="350" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="FormSecondaryColumn" Width="0" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            x:Name="BasicInputFormStack"
                            Margin="10"
                            HorizontalAlignment="Stretch">
                            <TextBlock
                                Margin="0,0,0,8"
                                Style="{StaticResource FormLabelTextBlockStyle}"
                                Text="{xaml:Localize Key=Name}" />
                            <TextBox Text="{x:Bind Model.Name, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource FormLabelTextBlockStyle}" Text="{xaml:Localize Key=Date}" />
                            <DatePicker Date="{x:Bind Model.Date, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource FormLabelTextBlockStyle}" Text="{xaml:Localize Key=Time}" />
                            <TimePicker Time="{x:Bind Model.Time, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource FormLabelTextBlockStyle}" Text="{xaml:Localize Key=Celebration}" />
                            <TextBox PlaceholderText="{x:Bind Model.DefaultCelebrationMessage, Mode=OneWay}" Text="{x:Bind Model.CelebrationMessage, Mode=TwoWay}" />

                        </StackPanel>
                        <Grid
                            x:Name="BackgroundControlGrid"
                            Grid.Row="1"
                            Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Margin="0,0,0,8"
                                Style="{StaticResource FormLabelTextBlockStyle}"
                                Text="{xaml:Localize Key=Background}" />
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Button
                                        Margin="0,0,0,10"
                                        Command="{x:Bind Model.ChooseYourImageCommand}"
                                        Content="{xaml:Localize Key=ChooseYourImage}" />
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="Normal"
                                        Text="{xaml:Localize Key=DefaultBackgrounds}" />
                                    <GridView
                                        Margin="0,5,0,0"
                                        ItemsSource="{x:Bind Model.DefaultBackgrounds}"
                                        SelectedItem="{Binding SelectedDefaultBackground, Mode=TwoWay}"
                                        SelectionMode="Single">
                                        <GridView.ItemTemplate>
                                            <DataTemplate x:DataType="models:DefaultBackground">
                                                <Border Background="{ThemeResource SystemControlBackgroundAccentBrush}">
                                                    <Image
                                                        Width="70"
                                                        Height="70"
                                                        Source="{x:Bind ThumbnailPath}"
                                                        Stretch="UniformToFill" />
                                                </Border>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>

                                </StackPanel>
                                <Grid
                                    Grid.Column="1"
                                    Height="180"
                                    Margin="20,0,0,0"
                                    VerticalAlignment="Top">
                                    <Border HorizontalAlignment="Stretch" Background="{ThemeResource SystemControlBackgroundAccentBrush}" />
                                    <Image
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Stretch="UniformToFill">
                                        <Image.Source>
                                            <Binding Path="BackgroundPath">
                                                <!--<Binding.TargetNullValue>
                                                    <ImageSource>/Assets/SampleBackgrounds/Thumbnails/BlankBackground.png</ImageSource>
                                                </Binding.TargetNullValue>-->
                                            </Binding>
                                        </Image.Source>
                                    </Image>
                                    <TextBlock
                                        Margin="10"
                                        VerticalAlignment="Bottom"
                                        Foreground="#FFF"
                                        Opacity="0.8"
                                        Text="{xaml:Localize Key=Preview}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>

            </Border>
        </ScrollViewer>
        <CommandBar Grid.Row="2">
            <AppBarButton
                Command="{x:Bind Model.SaveCommand}"
                Icon="Save"
                Label="{xaml:Localize Key=Save}" />
            <AppBarButton
                Command="{x:Bind Model.CancelCommand}"
                Icon="Cancel"
                Label="{xaml:Localize Key=Cancel}" />
        </CommandBar>
        <Grid
            Grid.RowSpan="3"
            Background="#88FFFFFF"
            Visibility="{x:Bind Model.IsWorking, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
            <ProgressRing
                Width="50"
                Height="50"
                BorderBrush="Black"
                Foreground="Black"
                IsActive="{x:Bind Model.IsWorking, Mode=OneWay}" />
        </Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="768" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="WrapperGridMaxColumn.MaxWidth" Value="1000" />
                        <Setter Target="FormSecondaryColumn.Width" Value="*" />
                        <Setter Target="BackgroundControlGrid.(Grid.Column)" Value="1" />
                        <Setter Target="BackgroundControlGrid.(Grid.Row)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</local:CountdownEditorViewBase>
