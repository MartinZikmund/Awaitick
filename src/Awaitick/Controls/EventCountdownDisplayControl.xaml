<UserControl
    x:Class="Awaitick.Controls.EventCountdownDisplayControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Awaitick.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xaml="using:Awaitick.Extensions.Xaml"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <!--  Background color  -->
        <Border>
            <Border.Background>
                <SolidColorBrush Color="{x:Bind Countdown.BackgroundColor, Mode=OneWay}" />
            </Border.Background>
        </Border>

        <!--  Background image  -->
        <Border Visibility="{x:Bind Countdown.BackgroundImageUri, Converter={StaticResource NonNullToVisibilityConverter}, FallbackValue=Collapsed, Mode=OneWay}">
            <Image
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="{x:Bind Countdown.BackgroundImageOpacity, Mode=OneWay}"
                Stretch="UniformToFill">
                <Image.Source>
                    <BitmapImage UriSource="{x:Bind Countdown.BackgroundImageUri, Mode=OneWay}" />
                </Image.Source>
            </Image>
        </Border>

        <Border Padding="{x:Bind Padding, Mode=OneWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Viewbox
                    MaxWidth="600"
                    Margin="20"
                    Visibility="{x:Bind Countdown.HasFinished, Converter={StaticResource InvertedBoolToVisibilityConverter}, Mode=OneWay}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Margin="10,0" Orientation="Vertical">
                            <TextBlock Style="{StaticResource TimeComponentStyle}" Text="{x:Bind Countdown.DaysLeft, Mode=OneWay, FallbackValue=00, Converter={StaticResource IntToTimeComponentStringConverter}}" />
                            <TextBlock Style="{StaticResource TimeComponentDescriptionStyle}" Text="{xaml:Localize Key=Days}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <StackPanel
                                Margin="10,0"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock Style="{StaticResource SecondaryTimeComponentStyle}" Text="{x:Bind Countdown.HoursLeft, Mode=OneWay, FallbackValue=00, Converter={StaticResource IntToTimeComponentStringConverter}}" />
                                <TextBlock Style="{StaticResource SecondaryTimeComponentDescriptionStyle}" Text="{xaml:Localize Key=Hours}" />
                            </StackPanel>
                            <StackPanel
                                Margin="10,0"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock Style="{StaticResource SecondaryTimeComponentStyle}" Text="{x:Bind Countdown.MinutesLeft, Mode=OneWay, FallbackValue=00, Converter={StaticResource IntToTimeComponentStringConverter}}" />
                                <TextBlock Style="{StaticResource SecondaryTimeComponentDescriptionStyle}" Text="{xaml:Localize Key=Minutes}" />
                            </StackPanel>
                            <StackPanel
                                Margin="10,0"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock Style="{StaticResource SecondaryTimeComponentStyle}" Text="{x:Bind Countdown.SecondsLeft, Mode=OneWay, FallbackValue=00, Converter={StaticResource IntToTimeComponentStringConverter}}" />
                                <TextBlock Style="{StaticResource SecondaryTimeComponentDescriptionStyle}" Text="{xaml:Localize Key=Seconds}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Viewbox>
                <TextBlock
                    Margin="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="55"
                    FontWeight="SemiLight"
                    Text="{x:Bind Countdown.CelebrationMessage}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind Countdown.HasFinished, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                <StackPanel
                    x:Name="BottomInfo"
                    Grid.Row="1"
                    VerticalAlignment="Bottom">
                    <TextBlock
                        x:Name="CountdownNameTextBlock"
                        Grid.Row="1"
                        Margin="20,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        FontSize="40"
                        Text="{x:Bind Countdown.Name, Mode=OneWay}" />
                    <TextBlock
                        x:Name="TargetDateTimeTextBlock"
                        Margin="22,0,0,20"
                        HorizontalAlignment="Left"
                        FontSize="18"
                        Opacity="0.8"
                        Text="{x:Bind Countdown.TargetDateTime}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
