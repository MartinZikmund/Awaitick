<UserControl
    x:Class="Awaitick.Controls.PageHeaderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Awaitick.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:Uno.UI.Toolkit"
    xmlns:xaml="using:Awaitick.Extensions.Xaml"
    d:DesignHeight="100"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid x:Name="HeaderGrid" toolkit:VisibleBoundsPadding.PaddingMask="Top,Left,Right">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button
            Command="{x:Bind GoBackCommand, Mode=OneWay}"
            Style="{ThemeResource NavigationBackButtonStyle}"
            ToolTipService.ToolTip="{xaml:Localize Key=Back}"
            Visibility="{x:Bind CanGoBack, Mode=OneWay}" />
        <TextBlock
            Grid.Column="1"
            FontWeight="{x:Bind FontWeight, Mode=OneWay}"
            Style="{ThemeResource TitleTextBlockStyle}"
            Text="{x:Bind Title, Mode=OneWay}" />
    </Grid>
</UserControl>
