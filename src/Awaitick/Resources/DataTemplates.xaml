<ResourceDictionary
    x:Class="Awaitick.Resources.DataTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Microsoft.Xaml.Interactions.Core"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:models="using:Awaitick.Core.Models"
    xmlns:utu="using:Uno.Toolkit.UI"
	xmlns:controls="using:Awaitick.Controls"
    xmlns:xaml="using:Awaitick.Extensions.Xaml">
    <DataTemplate x:Key="EventGridItemTemplate" x:DataType="models:CountdownViewModel">
        <UserControl>
            <Grid x:Name="MainGrid" Background="{ThemeResource SystemControlBackgroundAccentBrush}">
				<Border VerticalAlignment="Stretch" Visibility="{x:Bind BackgroundImageUri, Converter={StaticResource EmptyStringToVisibilityConverter}, FallbackValue=Visible}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#00FFFFFF" />
                            <GradientStop Offset="1" Color="#22FFFFFF" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
				<Grid Background="Black" Visibility="{x:Bind BackgroundImageUri, Converter={StaticResource NonEmptyStringToVisibilityConverter}, FallbackValue=Collapsed}">
                    <Image
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0.8"
                        Stretch="UniformToFill">
                        <Image.Source>
                            <BitmapImage UriSource="{x:Bind BackgroundImageUri, Mode=OneWay}" />
                        </Image.Source>
                    </Image>
                </Grid>
                <Border Padding="20" VerticalAlignment="Stretch">
                    <Grid>
                        <StackPanel
                            x:Name="CountdownStack"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Orientation="Horizontal"
                            Visibility="{x:Bind HasFinished, Converter={StaticResource InvertedBoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Visible}">
                            <StackPanel Margin="10,0" Orientation="Vertical">
                                <TextBlock
                                    x:Name="DaysComponent"
                                    Style="{StaticResource TimeComponentStyle}"
                                    Text="{x:Bind DaysLeft, Mode=OneWay, FallbackValue=00, Converter={StaticResource IntToTimeComponentStringConverter}}" />
                                <TextBlock Style="{StaticResource TimeComponentDescriptionStyle}" Text="{xaml:Localize Key=Days}" />
                            </StackPanel>
                            <StackPanel
                                Margin="10,0"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock
                                    x:Name="HoursComponent"
                                    Style="{StaticResource SecondaryTimeComponentStyle}"
                                    Text="{x:Bind HoursLeft, Mode=OneWay, FallbackValue=00, Converter={StaticResource IntToTimeComponentStringConverter}}" />
                                <TextBlock Style="{StaticResource SecondaryTimeComponentDescriptionStyle}" Text="{xaml:Localize Key=Hours}" />
                            </StackPanel>
                            <StackPanel
                                Margin="10,0"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock
                                    x:Name="MinutesComponent"
                                    Style="{StaticResource SecondaryTimeComponentStyle}"
                                    Text="{x:Bind MinutesLeft, Mode=OneWay, FallbackValue=00, Converter={StaticResource IntToTimeComponentStringConverter}}" />
                                <TextBlock Style="{StaticResource SecondaryTimeComponentDescriptionStyle}" Text="{xaml:Localize Key=Minutes}" />
                            </StackPanel>
                            <StackPanel
                                Margin="10,0"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock
                                    x:Name="SecondsComponent"
                                    Style="{StaticResource SecondaryTimeComponentStyle}"
                                    Text="{x:Bind SecondsLeft, Mode=OneWay, FallbackValue=00, Converter={StaticResource IntToTimeComponentStringConverter}}" />
                                <TextBlock Style="{StaticResource SecondaryTimeComponentDescriptionStyle}" Text="{xaml:Localize Key=Seconds}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock
                            Margin="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="35"
                            FontWeight="SemiLight"
                            Foreground="White"
                            Text="{x:Bind CelebrationMessage}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind HasFinished, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Collapsed}" />
                        <TextBlock
                            Margin="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            FontSize="30"
                            FontWeight="Normal"
                            Foreground="White"
                            Text="{x:Bind Name}"
                            TextLineBounds="Tight" />
                    </Grid>
                </Border>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState>
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="900" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="MainGrid.Width" Value="440" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState>
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1280" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="MainGrid.Width" Value="480" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState>
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1500" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="MainGrid.Width" Value="600" />
                                <Setter Target="MainGrid.Height" Value="300" />
                                <Setter Target="CountdownStack.VerticalAlignment" Value="Center" />
                                <Setter Target="CountdownStack.Margin" Value="0,0,0,0" />
                                <Setter Target="DaysComponent.Style" Value="{StaticResource LargeTimeComponentStyle}" />
                                <Setter Target="HoursComponent.Style" Value="{StaticResource LargeSecondaryTimeComponentStyle}" />
                                <Setter Target="MinutesComponent.Style" Value="{StaticResource LargeSecondaryTimeComponentStyle}" />
                                <Setter Target="SecondsComponent.Style" Value="{StaticResource LargeSecondaryTimeComponentStyle}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            </Grid>
        </UserControl>
    </DataTemplate>

    <DataTemplate x:Key="EventListItemTemplate" x:DataType="models:CountdownViewModel">
        <ItemContainer>
            <Grid
				Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                x:Name="MainGrid"
                HorizontalAlignment="Stretch">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            Command="{x:Bind ShareCommand}"
                            Icon="{xaml:FontIcon Glyph={StaticResource ShareIcon}}"
                            Text="{xaml:Localize Key=Share}" />
                        <MenuFlyoutItem
                            Command="{x:Bind GoToEditCommand}"
                            Icon="Edit"
                            Text="{xaml:Localize Key=Edit}" />
                        <MenuFlyoutItem
                            Command="{x:Bind DeleteCommand}"
                            Icon="Delete"
                            Text="{xaml:Localize Key=Delete}" />
                    </MenuFlyout>
                </Grid.ContextFlyout>
				<controls:EventCountdownDisplayControl Grid.Row="1" Countdown="{x:Bind Mode=OneWay}" DisplayMode="Compact" />
			</Grid>
        </ItemContainer>
    </DataTemplate>
</ResourceDictionary>
