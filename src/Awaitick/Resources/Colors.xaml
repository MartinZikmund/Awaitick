<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BrandColor">#04D4F0</Color>
    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}" />

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <Color x:Key="PageBackgroundSolidColor">#202020</Color>
            <Color x:Key="PageHeaderBackgroundSolidColor">#101010</Color>
            <SolidColorBrush x:Key="AppOverlayBackgroundBrush" Color="#44000000" />
            <SolidColorBrush x:Key="PageHeaderBackgroundBrush" Color="{ThemeResource PageHeaderBackgroundSolidColor}" />
            <AcrylicBrush
                x:Key="PageBackgroundBrush"
                TintColor="{ThemeResource PageBackgroundSolidColor}"
                TintOpacity="0.8" />
            <AcrylicBrush
                x:Key="FloatingToolbarBackgroundBrush"
                TintColor="#000000"
                TintOpacity="0.6"
                FallbackColor="#CC000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="PageBackgroundSolidColor">#F3F3F3</Color>
            <Color x:Key="PageHeaderBackgroundSolidColor">#F6F6F6</Color>
            <SolidColorBrush x:Key="AppOverlayBackgroundBrush" Color="#44FFFFFF" />
            <AcrylicBrush
                x:Key="PageHeaderBackgroundBrush"
                TintColor="{ThemeResource PageHeaderBackgroundSolidColor}"
                TintOpacity="0.9" />
            <AcrylicBrush
                x:Key="PageBackgroundBrush"
                TintColor="{ThemeResource PageBackgroundSolidColor}"
                TintOpacity="0.8" />
            <AcrylicBrush
                x:Key="FloatingToolbarBackgroundBrush"
                TintColor="#FFFFFF"
                TintOpacity="0.6"
                FallbackColor="#CCFFFFFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
