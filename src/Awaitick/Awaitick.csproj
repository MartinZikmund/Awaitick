<Project Sdk="Uno.Sdk">
	<PropertyGroup>
		<TargetFrameworks>
			net10.0-android;
			net10.0-ios;
			net10.0-windows10.0.26100;
			net10.0-desktop;
			net10.0-browserwasm;
		</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<UnoSingleProject>true</UnoSingleProject>

		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<UnoFeatures>
			Hosting;
			Mvvm;
			Configuration;
			Localization;
			Serialization;
			Toolkit;
			SkiaRenderer;
		</UnoFeatures>

		<UnoIconBackgroundFile>Assets/Icons/icon_transparent.svg</UnoIconBackgroundFile>
		<UnoIconBackgroundFile Condition="'$(IsIOS)' == 'true' or '$(IsAndroid)' == 'true'">Assets/Icons/icon.svg</UnoIconBackgroundFile>
		<!-- Only the foreground varies: the generated icon resource is named after the background. -->
		<UnoIconForegroundFile Condition="'$(AppChannel)' == 'Dev'">Assets/Icons/icon_foreground_dev.svg</UnoIconForegroundFile>

		<UnoIconForegroundScale>1</UnoIconForegroundScale>
		<UnoIconForegroundScale Condition="'$(IsAndroid)' == 'true'">0.65</UnoIconForegroundScale>

		<!-- App Store ITMS-90068: uploads need MinimumOSVersion 15.0+. Drop on Uno.Sdk 7 (new default). -->
		<SupportedOSPlatformVersion Condition="'$(IsIOS)' == 'true'">15.0</SupportedOSPlatformVersion>
		<!-- Google Play automatic protection needs API 24+. Drop on Uno.Sdk 7 (new default). -->
		<SupportedOSPlatformVersion Condition="'$(IsAndroid)' == 'true'">24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Fills PublisherDisplayName. The MSIX Publisher itself is in Package.appxmanifest. -->
		<ApplicationPublisher>Martin Zikmund</ApplicationPublisher>
	</PropertyGroup>

	<!-- Channel-specific identity. See docs/versioning.md. -->
	<PropertyGroup Condition="'$(AppChannel)' == 'Prod'">
		<ApplicationTitle>Awaitick</ApplicationTitle>
		<ApplicationId>dev.mzikmund.awaitick</ApplicationId>
		<!-- Partner Center assigned this identity, so Windows differs from the mobile id. -->
		<ApplicationId Condition="$(TargetFramework.Contains('windows10'))">5143MartinZikmund.Awaitick</ApplicationId>
	</PropertyGroup>

	<PropertyGroup Condition="'$(AppChannel)' == 'Dev'">
		<ApplicationTitle>Awaitick Dev</ApplicationTitle>
		<ApplicationId>dev.mzikmund.awaitick.dev</ApplicationId>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)'=='net10.0-browserwasm'">
		<WasmShellEnableIDBFS>true</WasmShellEnableIDBFS>
		<!-- Workaround for ILLink 10.0.7 crash (IL1012, "Sequence contains no elements" in
		     Mono.Linker.MessageOrigin.ToString) while formatting cached trim warnings from
		     Uno.Extensions (Configuration/Localization/Serialization) APIs annotated with
		     RequiresUnreferencedCode. Trimming itself still runs; only the warning output is suppressed. -->
		<SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
		<PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" />
		<PackageReference Include="CommunityToolkit.WinUI.Converters" />
		<PackageReference Include="CommunityToolkit.WinUI.Helpers" />
		<PackageReference Include="MZikmund.Toolkit.WinUI" />
		<PackageReference Include="Uno.Microsoft.Xaml.Behaviors.WinUI.Managed" Condition="!$(TargetFramework.Contains('windows10'))" />
		<PackageReference Include="Microsoft.Xaml.Behaviors.WinUI.Managed" Condition="$(TargetFramework.Contains('windows10'))" />
		<PackageReference Include="SourceGear.sqlite3" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Awaitick.Core\Awaitick.Core.csproj" />
	</ItemGroup>

	<!--
		Workaround: Uno.Sdk does not auto-include files under Platforms/Windows/ as Content for
		the WinAppSDK target, so manifest-referenced assets (splash/tiles/icons) are missing
		from the produced .msix. Remove once the Uno.Sdk fix ships.
	-->
	<ItemGroup Condition="$(TargetFramework.Contains('windows10'))">
		<Content Include="Platforms\Windows\**\*.png"
		         Exclude="@(Content)"
		         CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
</Project>
