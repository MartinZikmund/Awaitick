<local:OnboardingViewBase
    x:Class="Awaitick.Views.OnboardingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Awaitick.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:presets="using:Awaitick.Core.Models.Presets"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Image Source="ms-appx:///Assets/onboarding.jpg" Stretch="UniformToFill" />
        <FlipView Grid.Column="1" SelectedIndex="{x:Bind ViewModel.Step, Mode=TwoWay}">
            <FlipView.Resources>
                <Style TargetType="StackPanel">
                    <Setter Property="Spacing" Value="8" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                </Style>
                <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                </Style>
            </FlipView.Resources>
            <FlipViewItem>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        Text="Welcome to Awaitick!" />
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Your countdown to everything important." />
                    <TextBlock Text="Keep track of your events and never miss a beat!" />
                    <Button
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.NextStepCommand}"
                        Style="{ThemeResource AccentButtonStyle}">
                        Get started
                    </Button>
                </StackPanel>
            </FlipViewItem>
            <FlipViewItem>
                <StackPanel>
                    <TextBlock
                        Margin="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="32"
                        Text="Start with presets" />
                    <TextBlock Text="Here are some of our favorites!" />

                    <ItemsView
                        Width="500"
                        Height="400"
                        HorizontalAlignment="Left"
                        ItemsSource="{x:Bind ViewModel.Presets}"
                        SelectionMode="Multiple">
                        <ItemsView.Layout>
                            <UniformGridLayout
                                MaximumRowsOrColumns="3"
                                MinColumnSpacing="5"
                                MinRowSpacing="5" />
                        </ItemsView.Layout>
                        <ItemsView.ItemTemplate>
                            <DataTemplate x:DataType="presets:EventPreset">
                                <ItemContainer AutomationProperties.Name="{x:Bind Name}">
                                    <Grid Width="150">
                                        <Image
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Stretch="UniformToFill">
                                            <Image.Source>
                                                <BitmapImage UriSource="{x:Bind BackgroundImageUri}" />
                                            </Image.Source>
                                        </Image>
                                        <StackPanel
                                            Height="40"
                                            Padding="5,1,5,1"
                                            VerticalAlignment="Bottom"
                                            Background="{ThemeResource SystemControlBackgroundBaseMediumBrush}"
                                            Opacity=".75"
                                            Orientation="Vertical">
                                            <TextBlock Foreground="{ThemeResource SystemControlForegroundAltHighBrush}" Text="{x:Bind Name}" />
                                        </StackPanel>
                                    </Grid>
                                </ItemContainer>
                            </DataTemplate>
                        </ItemsView.ItemTemplate>
                    </ItemsView>
                    <Button>Save</Button>
                    <Button Command="{x:Bind ViewModel.StartAppCommand}">Skip</Button>

                </StackPanel>
            </FlipViewItem>
            <FlipViewItem>
                <StackPanel>
                    <TextBlock
                        Margin="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="32"
                        Text="Get Started!" />
                    <TextBlock Text="Let's get you set up." />
                    <TextBlock
                        Margin="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="24"
                        Text="Click below to begin using Awaitick." />
                </StackPanel>
            </FlipViewItem>
        </FlipView>
    </Grid>
</local:OnboardingViewBase>
