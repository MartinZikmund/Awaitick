<local:OnboardingViewBase
    x:Class="Awaitick.Views.OnboardingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Awaitick.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:presets="using:Awaitick.Core.Models.Presets"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <!--
    Adaptive Onboarding Layout:
    - Wide screens (>=640px): Two-column layout with image on left, content on right
    - Narrow screens (<640px): Single-column layout with reduced opacity background image and overlaid content
    -->
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Image
            x:Name="BackgroundImage"
            Source="ms-appx:///Assets/onboarding.jpg"
            Stretch="UniformToFill" />
        <FlipView
            x:Name="OnboardingFlipView"
            Grid.Column="1"
            SelectedIndex="{x:Bind ViewModel.Step, Mode=TwoWay}">
            <FlipView.Resources>
                <Style TargetType="StackPanel">
                    <Setter Property="Spacing" Value="8" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                </Style>
                <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
					<Setter Property="TextAlignment" Value="Center" />
					<Setter Property="TextWrapping" Value="Wrap" />
				</Style>
				<Style x:Name="SubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
					<Setter Property="TextAlignment" Value="Center" />
				</Style>
				<Style x:Name="TitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
					<Setter Property="TextAlignment" Value="Center" />
					<Setter Property="Margin" Value="12" />
					<Setter Property="FontSize" Value="40" />
				</Style>
            </FlipView.Resources>
            <FlipViewItem>
                <Border
                    x:Name="WelcomeContentBorder"
                    Margin="20"
                    Padding="24"
                    Background="Transparent"
                    CornerRadius="8">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            Style="{ThemeResource TitleStyle}"
                            Text="Welcome to Awaitick!" />
						<TextBlock Style="{ThemeResource SubtitleStyle}" Text="Your countdown to everything important." />
                        <TextBlock Text="Keep track of your events and never miss a beat!" />
                        <Button
                            HorizontalAlignment="Center"
                            Command="{x:Bind ViewModel.NextStepCommand}"
                            Style="{ThemeResource AccentButtonStyle}">
                            Get started
                        </Button>
                    </StackPanel>
                </Border>
            </FlipViewItem>
            <FlipViewItem>
                <Border
                    x:Name="PresetsContentBorder"
                    Margin="20"
                    Padding="8"
                    Background="Transparent"
                    CornerRadius="8">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Style="{ThemeResource TitleStyle}"
                            Text="Start with presets" />
                        <TextBlock Grid.Row="1" Style="{ThemeResource SubtitleStyle}" Text="Here are some of our favorites!" />

                        <ScrollViewer Grid.Row="2" HorizontalAlignment="Stretch">
                            <ItemsView
                                HorizontalAlignment="Center"
                                ItemsSource="{x:Bind ViewModel.Presets}"
                                SelectionChanged="PresetsSelectionChanged"
                                SelectionMode="Multiple">
                                <ItemsView.Layout>
                                    <UniformGridLayout
                                        MaximumRowsOrColumns="3"
                                        MinColumnSpacing="5"
                                        MinRowSpacing="5" />
                                </ItemsView.Layout>
                                <ItemsView.ItemTemplate>
                                    <DataTemplate x:DataType="presets:EventPreset">
                                        <ItemContainer AutomationProperties.Name="{x:Bind Name}">
                                            <Grid Width="160" Height="80">
                                                <Image
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Stretch="UniformToFill">
                                                    <Image.Source>
                                                        <BitmapImage UriSource="{x:Bind BackgroundImageUri}" />
                                                    </Image.Source>
                                                </Image>
                                                <Border
                                                    Padding="8"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                                                    CornerRadius="4"
                                                    Opacity="0.8">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                                        Text="{x:Bind Name}"
                                                        TextAlignment="Center"
                                                        TextWrapping="Wrap" />
                                                </Border>
                                            </Grid>
                                        </ItemContainer>
                                    </DataTemplate>
                                </ItemsView.ItemTemplate>
                            </ItemsView>
                        </ScrollViewer>
                        <StackPanel
                            Grid.Row="4"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button Command="{x:Bind ViewModel.SavePresetsCommand}">Save</Button>
                            <Button Command="{x:Bind ViewModel.SkipPresetsCommand}">Skip</Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </FlipViewItem>
            <FlipViewItem>
                <Border
                    x:Name="FinalContentBorder"
                    Margin="20"
                    Padding="24"
                    Background="Transparent"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            Style="{ThemeResource TitleStyle}"
                            Text="Get Started!" />
                        <TextBlock Style="{ThemeResource SubtitleStyle}" Text="Let's get you set up." />
                        <TextBlock
                            Margin="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="24"
                            Text="Click below to begin using Awaitick." />
                    </StackPanel>
                </Border>
            </FlipViewItem>
        </FlipView>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowStates">
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!--  Root layout setters  -->
                        <Setter Target="RootGrid.ColumnDefinitions[0].Width" Value="*" />
                        <Setter Target="RootGrid.ColumnDefinitions[1].Width" Value="*" />
                        <Setter Target="BackgroundImage.(Grid.Column)" Value="0" />
                        <Setter Target="BackgroundImage.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="BackgroundImage.Opacity" Value="1.0" />
                        <Setter Target="OnboardingFlipView.(Grid.Column)" Value="1" />
                        <Setter Target="OnboardingFlipView.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="OnboardingFlipView.Background" Value="Transparent" />


                        <!--  Content background setters for wide screens (transparent backgrounds)  -->
                        <Setter Target="WelcomeContentBorder.Background" Value="Transparent" />
                        <Setter Target="PresetsContentBorder.Background" Value="Transparent" />
                        <Setter Target="FinalContentBorder.Background" Value="Transparent" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!--  Root layout setters  -->
                        <Setter Target="RootGrid.ColumnDefinitions[0].Width" Value="*" />
                        <Setter Target="RootGrid.ColumnDefinitions[1].Width" Value="0" />
                        <Setter Target="BackgroundImage.(Grid.Column)" Value="0" />
                        <Setter Target="BackgroundImage.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="BackgroundImage.Opacity" Value="0.3" />
                        <Setter Target="OnboardingFlipView.(Grid.Column)" Value="0" />
                        <Setter Target="OnboardingFlipView.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="OnboardingFlipView.Background" Value="Transparent" />


                        <!--  Content background setters for narrow screens (acrylic backgrounds)  -->
                        <Setter Target="WelcomeContentBorder.Background" Value="{ThemeResource SystemControlAcrylicElementBrush}" />
                        <Setter Target="PresetsContentBorder.Background" Value="{ThemeResource SystemControlAcrylicElementBrush}" />
                        <Setter Target="FinalContentBorder.Background" Value="{ThemeResource SystemControlAcrylicElementBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</local:OnboardingViewBase>
