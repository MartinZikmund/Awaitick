<local:NewCountdownViewBase
    x:Class="Awaitick.Views.NewCountdownView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Awaitick.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:presets="using:Awaitick.Core.Models.Presets"
    xmlns:ui="using:Awaitick.Extensions.Xaml"
    xmlns:usercontrols="using:Awaitick.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <usercontrols:PageHeaderControl HorizontalAlignment="Center" Title="{x:Bind ViewModel.Title, Mode=OneWay}" />

        <Button
            Grid.Row="1"
            Margin="0,16,0,8"
            Padding="24,14"
            HorizontalAlignment="Center"
            Command="{x:Bind ViewModel.CreateOwnCommand}"
            Style="{ThemeResource AccentButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon FontSize="20" Glyph="&#xE70F;" />
                <TextBlock FontSize="18" Text="{ui:Localize Key=NewCountdown_CreateMyOwn}" />
            </StackPanel>
        </Button>

        <TextBlock
            Grid.Row="2"
            Margin="0,8,0,0"
            HorizontalAlignment="Center"
            Opacity="0.7"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{ui:Localize Key=NewCountdown_Or}" />

        <TextBlock
            x:Name="PresetsHeader"
            Grid.Row="3"
            Margin="0,4,0,8"
            HorizontalAlignment="Center"
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="{ui:Localize Key=NewCountdown_StartFromPreset}" />

        <ScrollViewer
            x:Name="PresetsScroll"
            Grid.Row="4"
            HorizontalAlignment="Stretch">
            <ItemsView
                x:Name="PresetsItemsView"
                Margin="0,0,0,24"
                HorizontalAlignment="Center"
                IsItemInvokedEnabled="True"
                ItemInvoked="PresetsItemInvoked"
                ItemsSource="{x:Bind ViewModel.Presets}"
                SelectionMode="None">
                <ItemsView.Layout>
                    <UniformGridLayout
                        MaximumRowsOrColumns="3"
                        MinColumnSpacing="8"
                        MinRowSpacing="8" />
                </ItemsView.Layout>
                <ItemsView.ItemTemplate>
                    <DataTemplate x:DataType="presets:EventPreset">
                        <ItemContainer AutomationProperties.Name="{x:Bind Name}">
                            <Grid Width="160" Height="80">
                                <Image
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Stretch="UniformToFill">
                                    <Image.Source>
                                        <BitmapImage UriSource="{x:Bind BackgroundImageUri}" />
                                    </Image.Source>
                                </Image>
                                <Border
                                    Padding="8"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                                    CornerRadius="4"
                                    Opacity="0.8">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                        Text="{x:Bind Name}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                        </ItemContainer>
                    </DataTemplate>
                </ItemsView.ItemTemplate>
            </ItemsView>
        </ScrollViewer>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PresetsScroll.Padding" Value="12,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="768" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PresetsScroll.Padding" Value="24,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</local:NewCountdownViewBase>
