<local:CountdownDetailViewBase
    x:Class="Awaitick.Views.CountdownDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Awaitick.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xaml="using:Awaitick.Extensions.Xaml"
    xmlns:controls="using:Awaitick.Controls"
    mc:Ignorable="d">
    <local:CountdownDetailViewBase.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition>
                <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                    <DrillInNavigationTransitionInfo />
                </NavigationThemeTransition.DefaultNavigationTransitionInfo>
            </NavigationThemeTransition>
        </TransitionCollection>
    </local:CountdownDetailViewBase.Transitions>
    <Grid>
        <controls:EventCountdownDisplayControl
            Padding="0,48,0,0"
            Countdown="{x:Bind ViewModel.EventCountdown, Mode=OneWay}"
            DisplayMode="Full" />

        <!-- Floating pill toolbar -->
        <Border
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,24"
            Padding="8,4"
            CornerRadius="24"
            Background="{ThemeResource FloatingToolbarBackgroundBrush}">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <StackPanel
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    Command="{x:Bind ViewModel.ShareCommand}"
                    Style="{StaticResource FloatingToolbarButtonStyle}"
                    ToolTipService.ToolTip="{xaml:Localize Key=Share}">
                    <SymbolIcon Symbol="Share" />
                </Button>
                <Button
                    Command="{x:Bind ViewModel.EditCommand}"
                    Style="{StaticResource FloatingToolbarButtonStyle}"
                    ToolTipService.ToolTip="{xaml:Localize Key=Edit}">
                    <SymbolIcon Symbol="Edit" />
                </Button>
                <Button
                    Command="{x:Bind ViewModel.DeleteCommand}"
                    Style="{StaticResource FloatingToolbarButtonStyle}"
                    ToolTipService.ToolTip="{xaml:Localize Key=Delete}">
                    <SymbolIcon Symbol="Delete" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</local:CountdownDetailViewBase>
