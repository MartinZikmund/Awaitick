<local:GetProViewBase
    x:Class="Awaitick.Views.GetProView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="using:Awaitick.Extensions.Xaml"
    xmlns:local="using:Awaitick.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:usercontrols="using:Awaitick.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <usercontrols:PageHeaderControl Title="{ex:Localize Key=FluentAwaitickPro}" />
        <ScrollViewer
            Grid.Row="1"
            Padding="8"
            VerticalAlignment="Center">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="1"
                    MaxWidth="800"
                    Margin="36,0,36,8"
                    ColumnSpacing="8"
                    RowSpacing="8">
                    <Grid.Resources>
                        <Style x:Key="HeaderStyle" TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="FontSize" Value="20" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="8" />
                        </Style>
                        <Style x:Key="CaptionStyle" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="TextAlignment" Value="Center" />
                            <Setter Property="TextWrapping" Value="WrapWholeWords" />
                        </Style>
                        <Style TargetType="Image">
                            <Setter Property="MaxWidth" Value="180" />
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0">
                        <Image Source="ms-appx:///Assets/Pro/removeads.png" />
                        <TextBlock
                            Grid.Row="1"
                            Style="{StaticResource HeaderStyle}"
                            Text="{ex:Localize Key=NoAds}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Row="1"
                            Style="{StaticResource CaptionStyle}"
                            Text="{ex:Localize Key=NoAdsDescription}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <Image Source="ms-appx:///Assets/Pro/customize.png" />
                        <TextBlock
                            Grid.Row="1"
                            Style="{StaticResource HeaderStyle}"
                            Text="{ex:Localize Key=EndlessCustomization}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Row="1"
                            Style="{StaticResource CaptionStyle}"
                            Text="{ex:Localize Key=EndlessCustomizationDescription}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Image Source="ms-appx:///Assets/Pro/support.png" />
                        <TextBlock
                            Grid.Row="1"
                            Style="{StaticResource HeaderStyle}"
                            Text="{ex:Localize Key=SupportDevelopment}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Row="1"
                            Style="{StaticResource CaptionStyle}"
                            Text="{ex:Localize Key=SupportDevelopmentDescription}" />
                    </StackPanel>

                    <TextBlock
                        Grid.Row="1"
                        Grid.ColumnSpan="3"
                        Margin="8,24,8,0"
                        HorizontalAlignment="Center"
                        FontSize="24"
                        Text="{ex:Localize Key=FutureProFeatures}"
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                </Grid>
                <StackPanel
                    Grid.Row="2"
                    Spacing="4"
                    Visibility="{x:Bind ViewModel.CurrentPrice, Mode=OneWay, Converter={StaticResource NonNullToVisibilityConverter}}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="{ex:Localize Key=InAppPriceOnly}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="30"
                        Text="{x:Bind ViewModel.CurrentPrice, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <StackPanel
            Grid.Row="2"
            Margin="0"
            Spacing="16">
            <Button
                Padding="30"
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.GetProCommand}"
                CornerRadius="0"
                FontSize="30"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="30" Glyph="&#xE7BF;" />
                    <TextBlock Text="{ex:Localize Key=GetProNow}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</local:GetProViewBase>
