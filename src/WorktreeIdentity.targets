<Project>

	<!--
		Worktree-scoped app identity: APPLICATION.

		WorktreeIdentity.props derives the tags and this file applies them. It lives in .targets
		(imported after the project body) because the suffix goes on top of the ApplicationId and
		ApplicationTitle that Awaitick.csproj sets per AppChannel.

		Full documentation: docs/worktree-identity.md
	-->

	<!-- The Publisher isn't touched, and neither are the icons: the generated icon resource is
	     named after the background file, so varying it would break Android's @mipmap/icon. -->
	<PropertyGroup Condition="'$(_WorktreeIdentityAllowed)' == 'true' and '$(MSBuildProjectName)' == 'Awaitick'">
		<ApplicationId>$(ApplicationId).$(_WtIdSegment)</ApplicationId>
		<ApplicationTitle>$(ApplicationTitle) ($(_WtLongTag))</ApplicationTitle>
	</PropertyGroup>

	<!--
		Generates AppEnvironment.WorktreeName so the running app can show which worktree it came from.

		The stamp is part of the output path on purpose. The name can change without touching a
		project file (git worktree move, or -p:AppWorktreeName=), and with a fixed path a stale
		constant could survive in obj/ and the badge would name the wrong worktree.

		XamlPreCompile is load-bearing: the WinAppSDK head runs a full C# compile under that target
		before CoreCompile, so without it the Windows head fails with CS0117.
	-->
	<Target Name="GenerateWorktreeInfo"
	        Condition="'$(MSBuildProjectName)' == 'Awaitick'"
	        BeforeTargets="BeforeCompile;CoreCompile;XamlPreCompile">
		<PropertyGroup>
			<_WtStamp Condition="'$(_WorktreeIdentityAllowed)' == 'true'">$(_WtIdSegment)</_WtStamp>
			<_WtStamp Condition="'$(_WtStamp)' == ''">none</_WtStamp>
			<_WorktreeInfoFile>$(IntermediateOutputPath)AppEnvironment.Worktree.$(_WtStamp).g.cs</_WorktreeInfoFile>
			<_WtNameForCode Condition="'$(_WorktreeIdentityAllowed)' == 'true'">$(_WtDisp)</_WtNameForCode>
		</PropertyGroup>

		<WriteLinesToFile File="$(_WorktreeInfoFile)"
		                  Overwrite="true"
		                  WriteOnlyWhenDifferent="true"
		                  Lines="// &lt;auto-generated /&gt;;namespace Awaitick.Infrastructure%3B;;public static partial class AppEnvironment;{;    /// &lt;summary&gt;Git worktree this build came from, or empty for the main checkout.&lt;/summary&gt;;    public const string WorktreeName = &quot;$(_WtNameForCode)&quot;%3B;}" />

		<ItemGroup>
			<Compile Include="$(_WorktreeInfoFile)" />
			<FileWrites Include="$(_WorktreeInfoFile)" />
		</ItemGroup>
	</Target>

	<!--
		Android launcher label. It comes from Strings.xml rather than ApplicationTitle, so the channel
		and the worktree tag have to be added to the resource.

		The file is written over the copy the SDK has already staged into obj/.../res/, because
		swapping @(AndroidResource) items doesn't work: the SDK fixes its resource list before
		Directory.Build.targets can influence it, so the build would silently ship the plain label.

		The content always comes from the tracked source, never the staged copy, which keeps this
		idempotent across incremental builds. Forward slashes because Android builds on Linux too.
	-->
	<PropertyGroup>
		<_MobileLabelSuffix Condition="'$(AppChannel)' == 'Dev'">Dev</_MobileLabelSuffix>
		<_MobileLabelSuffix Condition="'$(AppChannel)' == 'Dev' and '$(_WorktreeIdentityAllowed)' == 'true'">Dev [$(_WtShortTag)]</_MobileLabelSuffix>
	</PropertyGroup>

	<ItemGroup Condition="'$(MSBuildProjectName)' == 'Awaitick' and '$(_MobileLabelSuffix)' != '' and '$(TargetPlatformIdentifier)' == 'android'">
		<_MobileLabelAndroidSrc Include="$(MSBuildProjectDirectory)/Platforms/Android/Resources/**/Strings.xml" />
	</ItemGroup>

	<Target Name="ApplyMobileLabelAndroid"
	        Condition="'$(MSBuildProjectName)' == 'Awaitick' and '$(_MobileLabelSuffix)' != '' and '$(TargetPlatformIdentifier)' == 'android'"
	        Outputs="%(_MobileLabelAndroidSrc.RecursiveDir)"
	        BeforeTargets="_CompileResources">
		<PropertyGroup>
			<!-- Batched, so %() is scalar here. Outside a batched target RecursiveDir is empty and the
			     resource lands in res/ instead of res/values/, which aapt2 rejects (APT2144). -->
			<_MobileLabelResDest>$(IntermediateOutputPath)res/%(_MobileLabelAndroidSrc.RecursiveDir)strings.xml</_MobileLabelResDest>
		</PropertyGroup>

		<WriteLinesToFile File="$(_MobileLabelResDest)"
		                  Lines="$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('%(_MobileLabelAndroidSrc.FullPath)')), '(&lt;string name=&quot;ApplicationName&quot;&gt;)([^&lt;]*)(&lt;/string&gt;)', '$1$2 $(_MobileLabelSuffix)$3'))"
		                  Overwrite="true"
		                  WriteOnlyWhenDifferent="true" />
	</Target>

	<!-- WebAssembly has no install identity, so report the per-worktree dev-server port. The launch
	     profiles are tracked files and are deliberately not rewritten for each worktree. -->
	<Target Name="ReportWorktreeDevPort"
	        Condition="'$(_WorktreeIdentityAllowed)' == 'true' and '$(TargetPlatformIdentifier)' == 'browserwasm'"
	        AfterTargets="Build">
		<Message Importance="High"
		         Text="Worktree '$(AppWorktreeName)': serve this head on its own origin with --urls http://localhost:$(_WtDevPort) (port 5000 is reserved for the main checkout)." />
	</Target>

</Project>
