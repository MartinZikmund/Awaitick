<local:CountdownDetailViewBase
    x:Class="EventCountdowns.Views.CountdownDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EventCountdowns.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:xaml="using:EventCountdowns.Extensions.Xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <local:CountdownDetailViewBase.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition>
                <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                    <DrillInNavigationTransitionInfo />
                </NavigationThemeTransition.DefaultNavigationTransitionInfo>
            </NavigationThemeTransition>
        </TransitionCollection>
    </local:CountdownDetailViewBase.Transitions>
    <Grid Background="{ThemeResource SystemControlBackgroundAccentBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="{x:Bind Model.EventCountdown.BackgroundImagePath, Converter={StaticResource NonEmptyStringToVisibilityConverter}, FallbackValue=Collapsed, Mode=OneWay}" Background="Black">
            <Image HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8" Stretch="UniformToFill">
                <Image.Source>
                    <Binding Path="EventCountdown.BackgroundImagePath">
                        <!--<Binding.TargetNullValue>
                            <ImageSource>/Assets/SampleBackgrounds/BlankBackground.png</ImageSource>
                        </Binding.TargetNullValue>-->
                    </Binding>
                </Image.Source>
            </Image>
        </Border>
        <Border Grid.Row="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Viewbox Margin="20" MaxWidth="600" Visibility="{x:Bind Model.EventCountdown.Finished, Converter={StaticResource InvertedBoolToVisibilityConverter}, Mode=OneWay}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Vertical" Margin="10,0">
                            <TextBlock Style="{StaticResource TimeComponentStyle}" Text="{x:Bind Model.EventCountdown.DaysLeft, Mode=OneWay, FallbackValue=00, Converter={StaticResource IntToTimeComponentStringConverter}}" />
                            <TextBlock Style="{StaticResource TimeComponentDescriptionStyle}" Text="{xaml:Localize Key=Days}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Orientation="Horizontal">
                            <StackPanel Orientation="Vertical" Margin="10,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SecondaryTimeComponentStyle}" Text="{x:Bind Model.EventCountdown.HoursLeft, Mode=OneWay, FallbackValue=00, Converter={StaticResource IntToTimeComponentStringConverter}}" />
                                <TextBlock Style="{StaticResource SecondaryTimeComponentDescriptionStyle}" Text="{xaml:Localize Key=Hours}" />
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Margin="10,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SecondaryTimeComponentStyle}" Text="{x:Bind Model.EventCountdown.MinutesLeft, Mode=OneWay, FallbackValue=00, Converter={StaticResource IntToTimeComponentStringConverter}}" />
                                <TextBlock Style="{StaticResource SecondaryTimeComponentDescriptionStyle}" Text="{xaml:Localize Key=Minutes}" />
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Margin="10,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SecondaryTimeComponentStyle}" Text="{x:Bind Model.EventCountdown.SecondsLeft, Mode=OneWay, FallbackValue=00, Converter={StaticResource IntToTimeComponentStringConverter}}" />
                                <TextBlock Style="{StaticResource SecondaryTimeComponentDescriptionStyle}" Text="{xaml:Localize Key=Seconds}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Viewbox>
                <TextBlock TextWrapping="Wrap" Margin="20" TextAlignment="Center" FontWeight="SemiLight" HorizontalAlignment="Center" Foreground="White" Text="{x:Bind Model.EventCountdown.CelebrationMessage}" VerticalAlignment="Center" FontSize="55" Visibility="{x:Bind Model.EventCountdown.Finished, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                    <TextBlock Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Text="{x:Bind Model.EventCountdown.Name, Mode=OneWay}" FontSize="40" Foreground="White" Margin="20,0,0,0" />
                    <TextBlock Text="{x:Bind Model.TargetDateString}" HorizontalAlignment="Left" Margin="22,0,0,20" Opacity="0.8" FontSize="18" Foreground="White" />
                </StackPanel>
            </Grid>
        </Border>
        <CommandBar Grid.ColumnSpan="2" Grid.Row="2" IsOpen="False" ClosedDisplayMode="Minimal">
            <AppBarButton Label="{xaml:Localize Key=Share}" Command="{x:Bind Model.ShareCommand}">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72D;"/>
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Icon="Pin" Label="{xaml:Localize Key=PinToStart}" Visibility="{x:Bind Model.IsTilePinned, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}" Command="{x:Bind Model.PinCommand}" />
            <AppBarButton Icon="UnPin" Label="{xaml:Localize Key=UnpinFromStart}" Visibility="{x:Bind Model.IsTilePinned, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Command="{x:Bind Model.UnPinCommand}" />
            <AppBarButton Icon="Edit" Label="{xaml:Localize Key=Edit}" Command="{x:Bind Model.EditCommand}" />
            <CommandBar.SecondaryCommands>
                <AppBarButton Icon="Delete" Label="{xaml:Localize Key=Delete}" Command="{x:Bind Model.DeletePromptCommand}" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Grid>
</local:CountdownDetailViewBase>
