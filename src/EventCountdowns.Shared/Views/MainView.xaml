<local:MainViewBase
    x:Class="EventCountdowns.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EventCountdowns.Core.Controls"
    xmlns:core="using:Microsoft.Xaml.Interactions.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:EventCountdowns.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:EventCountdowns.Core.Models"
    xmlns:xaml="using:EventCountdowns.Extensions.Xaml"
    mc:Ignorable="d">
    <local:MainViewBase.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition />
        </TransitionCollection>
    </local:MainViewBase.Transitions>

    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="MobileAdRow" Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="DesktopAdColumn" Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Padding="0,40,0,20" Background="{ThemeResource PageHeaderBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                HorizontalAlignment="Center"
                FontWeight="SemiBold"
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="EVENT COUNTDOWNS" />
            <Button />
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition />
                </TransitionCollection>
            </Grid.ChildrenTransitions>
            <Grid Visibility="{x:Bind Model.HasAnyEvents, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <controls:EventsGridView
                        Name="AdaptiveGridViewControl"
                        ItemContainerStyle="{StaticResource TightGridViewItemContainerStyle}"
                        ItemTemplate="{StaticResource EventListItemTemplate}"
                        ItemsSource="{x:Bind Model.EventCountdowns}"
                        Style="{StaticResource EventGridViewStyle}" />
                </Grid>
            </Grid>
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{x:Bind Model.HasAnyEvents, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                <Image
                    Width="160"
                    Height="160"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Source="ms-appx:///Assets/AddEvent.svg"
                    Stretch="Fill" />
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Add your first event" />
            </StackPanel>
        </Grid>

        <!--  Commands  -->
        <CommandBar Grid.Row="3" Grid.ColumnSpan="2">
            <AppBarButton
                Command="{x:Bind Model.AddCommand}"
                Icon="Add"
                Label="{xaml:Localize Key=AddEvent}" />
            <AppBarButton
                Command="{x:Bind Model.BuyMeCoffeeCommand}"
                Label="{xaml:Localize Key=BuyMeCoffee}"
                Visibility="{x:Bind Model.ShowCoffee, Converter={StaticResource BoolToVisibilityConverter}}">
                <AppBarButton.Icon>
                    <BitmapIcon
                        Height="25"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        UriSource="/Assets/Icons/Mug.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <!--<AppBarButton Icon="Bullets" Label="{xaml:Localize Key=Manage}" />-->
            <!--<AppBarButton Icon="Accept" Click="ButtonBase_OnClick" Label="{xaml:Localize Key=Done}" />-->
            <CommandBar.SecondaryCommands>
                <AppBarButton Command="{x:Bind Model.AboutAppCommand}" Label="{xaml:Localize Key=AboutApp}" />
                <AppBarButton Command="{x:Bind Model.RateAppCommand}" Label="{xaml:Localize Key=RateThisApp}" />
                <AppBarButton Command="{x:Bind Model.SendFeedbackCommand}" Label="{xaml:Localize Key=SendFeedback}" />
                <AppBarButton
                    Command="{x:Bind Model.BuyMeCoffeeCommand}"
                    Label="{xaml:Localize Key=BuyMeCoffee}"
                    Visibility="{x:Bind Model.ShowCoffee, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowSizeGroup">
                <VisualState />
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="800" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters />
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</local:MainViewBase>
