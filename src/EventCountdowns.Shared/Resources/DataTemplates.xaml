<ResourceDictionary
    x:Class="EventCountdowns.Resources.DataTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:EventCountdowns.Core.Models"
    xmlns:xaml="using:EventCountdowns.Extensions.Xaml">
    <DataTemplate x:Key="EventGridItemTemplate" x:DataType="models:EventCountdownObservable">
        <UserControl>
            <Grid Background="{ThemeResource SystemControlBackgroundAccentBrush}" x:Name="MainGrid" Height="210" Width="340">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState>
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="900" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="MainGrid.Width" Value="450" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState>
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1280" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="MainGrid.Width" Value="450" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState>
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1500" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="MainGrid.Width" Value="600" />
                                <Setter Target="MainGrid.Height" Value="300" />
                                <Setter Target="CountdownStack.VerticalAlignment" Value="Center" />
                                <Setter Target="CountdownStack.Margin" Value="0,0,0,20" />
                                <Setter Target="DaysComponent.Style" Value="{StaticResource LargeTimeComponentStyle}" />
                                <Setter Target="HoursComponent.Style" Value="{StaticResource LargeSecondaryTimeComponentStyle}" />
                                <Setter Target="MinutesComponent.Style" Value="{StaticResource LargeSecondaryTimeComponentStyle}" />
                                <Setter Target="SecondsComponent.Style" Value="{StaticResource LargeSecondaryTimeComponentStyle}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Border VerticalAlignment="Stretch" Visibility="{x:Bind BackgroundImagePath, Converter={StaticResource EmptyStringToVisibilityConverter}, FallbackValue=Visible}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#00FFFFFF" Offset="0" />
                            <GradientStop Color="#22FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Grid Background="Black" Visibility="{x:Bind BackgroundImagePath, Converter={StaticResource NonEmptyStringToVisibilityConverter}, FallbackValue=Collapsed}">
                    <Image VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="UniformToFill" Opacity="0.8">
                        <Image.Source>
                            <Binding Path="BackgroundImagePath" Mode="OneTime">
                                <!--<Binding.TargetNullValue>
                                                <ImageSource>/Assets/SampleBackgrounds/BlankBackground.png</ImageSource>
                                            </Binding.TargetNullValue>-->
                            </Binding>
                        </Image.Source>
                    </Image>
                </Grid>
                <Border VerticalAlignment="Stretch" Padding="20">
                    <Grid>
                        <StackPanel x:Name="CountdownStack" Visibility="{x:Bind Finished, Converter={StaticResource InvertedBoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Visible}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" Orientation="Horizontal">
                            <StackPanel Orientation="Vertical" Margin="10,0">
                                <TextBlock x:Name="DaysComponent" Style="{StaticResource TimeComponentStyle}" Text="{x:Bind DaysLeft, Mode=OneWay, FallbackValue=00, Converter={StaticResource IntToTimeComponentStringConverter}}" />
                                <TextBlock Style="{StaticResource TimeComponentDescriptionStyle}" Text="{xaml:Localize Key=Days}" />
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Margin="10,0" VerticalAlignment="Center">
                                <TextBlock x:Name="HoursComponent" Style="{StaticResource SecondaryTimeComponentStyle}" Text="{x:Bind HoursLeft, Mode=OneWay, FallbackValue=00, Converter={StaticResource IntToTimeComponentStringConverter}}" />
                                <TextBlock Style="{StaticResource SecondaryTimeComponentDescriptionStyle}" Text="{xaml:Localize Key=Hours}" />
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Margin="10,0" VerticalAlignment="Center">
                                <TextBlock x:Name="MinutesComponent" Style="{StaticResource SecondaryTimeComponentStyle}" Text="{x:Bind MinutesLeft, Mode=OneWay, FallbackValue=00, Converter={StaticResource IntToTimeComponentStringConverter}}" />
                                <TextBlock Style="{StaticResource SecondaryTimeComponentDescriptionStyle}" Text="{xaml:Localize Key=Minutes}" />
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Margin="10,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SecondsComponent" Style="{StaticResource SecondaryTimeComponentStyle}" Text="{x:Bind SecondsLeft, Mode=OneWay, FallbackValue=00, Converter={StaticResource IntToTimeComponentStringConverter}}" />
                                <TextBlock Style="{StaticResource SecondaryTimeComponentDescriptionStyle}" Text="{xaml:Localize Key=Seconds}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0" TextAlignment="Center" FontWeight="SemiLight" HorizontalAlignment="Center" Foreground="White" Text="{x:Bind CelebrationMessage}" VerticalAlignment="Center" FontSize="35" Visibility="{x:Bind Finished, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Collapsed}" />
                        <TextBlock FontSize="30" Margin="0" TextLineBounds="Tight" HorizontalAlignment="Left" Foreground="White" FontWeight="Normal" VerticalAlignment="Bottom" Text="{x:Bind Name}" />
                    </Grid>
                </Border>
            </Grid>
        </UserControl>
    </DataTemplate>

    <DataTemplate x:Key="EventListItemTemplate" x:DataType="models:EventCountdownObservable">
        <UserControl>
            <Grid Background="{ThemeResource SystemControlBackgroundAccentBrush}" x:Name="MainGrid" Height="200" HorizontalAlignment="Stretch">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState>
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="400" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="MainGrid.Height" Value="220" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState>
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="550" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="MainGrid.Height" Value="240" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Border VerticalAlignment="Stretch" Visibility="{x:Bind BackgroundImagePath, Converter={StaticResource EmptyStringToVisibilityConverter}, FallbackValue=Visible}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#00FFFFFF" Offset="0" />
                            <GradientStop Color="#22FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Grid Background="Black" Visibility="{x:Bind BackgroundImagePath, Converter={StaticResource NonEmptyStringToVisibilityConverter}, FallbackValue=Collapsed}">
                    <Image VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="UniformToFill" Opacity="0.8">
                        <Image.Source>
                            <Binding Path="BackgroundImagePath" Mode="OneTime">
                                <!--<Binding.TargetNullValue>
                                                    <ImageSource>/Assets/SampleBackgrounds/BlankBackground.png</ImageSource>
                                                </Binding.TargetNullValue>-->
                            </Binding>
                        </Image.Source>
                    </Image>
                </Grid>
                <Border VerticalAlignment="Stretch" Padding="20">
                    <Grid>
                        <StackPanel Visibility="{x:Bind Finished, Converter={StaticResource InvertedBoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Visible}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" Orientation="Horizontal">
                            <StackPanel Orientation="Vertical" Margin="10,0">
                                <TextBlock Style="{StaticResource TimeComponentStyle}" Text="{x:Bind DaysLeft, Mode=OneWay, FallbackValue=00, Converter={StaticResource IntToTimeComponentStringConverter}}" />
                                <TextBlock Style="{StaticResource TimeComponentDescriptionStyle}" Text="{xaml:Localize Key=Days}" />
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Margin="10,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SecondaryTimeComponentStyle}" Text="{x:Bind HoursLeft, Mode=OneWay, FallbackValue=00, Converter={StaticResource IntToTimeComponentStringConverter}}" />
                                <TextBlock Style="{StaticResource SecondaryTimeComponentDescriptionStyle}" Text="{xaml:Localize Key=Hours}" />
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Margin="10,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SecondaryTimeComponentStyle}" Text="{x:Bind MinutesLeft, Mode=OneWay, FallbackValue=00, Converter={StaticResource IntToTimeComponentStringConverter}}" />
                                <TextBlock Style="{StaticResource SecondaryTimeComponentDescriptionStyle}" Text="{xaml:Localize Key=Minutes}" />
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Margin="10,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SecondaryTimeComponentStyle}" Text="{x:Bind SecondsLeft, Mode=OneWay, FallbackValue=00, Converter={StaticResource IntToTimeComponentStringConverter}}" />
                                <TextBlock Style="{StaticResource SecondaryTimeComponentDescriptionStyle}" Text="{xaml:Localize Key=Seconds}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0" TextAlignment="Center" FontWeight="SemiLight" HorizontalAlignment="Center" Foreground="White" Text="{x:Bind CelebrationMessage}" VerticalAlignment="Center" FontSize="35" Visibility="{x:Bind Finished, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Collapsed}" />
                        <TextBlock FontSize="30" Margin="0" TextLineBounds="Tight" HorizontalAlignment="Left" Foreground="White" FontWeight="Normal" VerticalAlignment="Bottom" Text="{x:Bind Name}" />
                    </Grid>
                </Border>
            </Grid>
        </UserControl>
    </DataTemplate>
</ResourceDictionary>
