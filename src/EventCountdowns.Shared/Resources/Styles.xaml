<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="TimeComponentStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="FontSize" Value="55" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style x:Key="SecondaryTimeComponentStyle" BasedOn="{StaticResource TimeComponentStyle}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="38" />
    </Style>
    <Style x:Key="TimeComponentDescriptionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style x:Key="SecondaryTimeComponentDescriptionStyle" BasedOn="{StaticResource TimeComponentStyle}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
    </Style>
    
    <Style x:Key="LargeTimeComponentStyle" TargetType="TextBlock" BasedOn="{StaticResource TimeComponentStyle}">
        <Setter Property="FontSize" Value="65" />
    </Style>

    <Style x:Key="LargeSecondaryTimeComponentStyle" TargetType="TextBlock" BasedOn="{StaticResource TimeComponentStyle}">
        <Setter Property="FontSize" Value="48" />
    </Style>

    <Style x:Key="LargeTimeComponentDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource TimeComponentStyle}">
        <Setter Property="FontSize" Value="25" />
    </Style>

    <Style x:Key="LargeSecondaryTimeComponentDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource TimeComponentStyle}">
        <Setter Property="FontSize" Value="20" />
    </Style>

    <Style x:Key="FormLabelTextBlockStyle" BasedOn="{StaticResource SubtitleTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,12,0,8" />
    </Style>

    <SolidColorBrush x:Key="AppThemeColor" Color="#23A0EA" />
    
    <SolidColorBrush x:Key="CommandBarBackgroundBrsuh" Color="#E6E6E6" />
</ResourceDictionary>
