<local:CountdownDetailViewBase
    x:Class="EventCountdowns.Views.CountdownDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:EventCountdowns.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xaml="using:EventCountdowns.Extensions.Xaml"
    mc:Ignorable="d">
    <local:CountdownDetailViewBase.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition>
                <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                    <DrillInNavigationTransitionInfo />
                </NavigationThemeTransition.DefaultNavigationTransitionInfo>
            </NavigationThemeTransition>
        </TransitionCollection>
    </local:CountdownDetailViewBase.Transitions>
    <Grid Background="{ThemeResource SystemControlBackgroundAccentBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            Background="Black"
            Visibility="{x:Bind ViewModel.Event.BackgroundImage, Converter={StaticResource NonNullToVisibilityConverter}, FallbackValue=Collapsed, Mode=OneWay}">
            <Image
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.8"
                Stretch="UniformToFill">
                <Image.Source>
                    <BitmapImage UriSource="{x:Bind ViewModel.Event.BackgroundImage, Mode=OneWay}" />
                </Image.Source>
            </Image>
        </Border>
        <Border Grid.Row="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Viewbox
                    MaxWidth="600"
                    Margin="20"
                    Visibility="{x:Bind ViewModel.Event.Finished, Converter={StaticResource InvertedBoolToVisibilityConverter}, Mode=OneWay}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Margin="10,0" Orientation="Vertical">
                            <TextBlock Style="{StaticResource TimeComponentStyle}" Text="{x:Bind ViewModel.Event.DaysLeft, Mode=OneWay, FallbackValue=00, Converter={StaticResource IntToTimeComponentStringConverter}}" />
                            <TextBlock Style="{StaticResource TimeComponentDescriptionStyle}" Text="{xaml:Localize Key=Days}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <StackPanel
                                Margin="10,0"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock Style="{StaticResource SecondaryTimeComponentStyle}" Text="{x:Bind ViewModel.Event.HoursLeft, Mode=OneWay, FallbackValue=00, Converter={StaticResource IntToTimeComponentStringConverter}}" />
                                <TextBlock Style="{StaticResource SecondaryTimeComponentDescriptionStyle}" Text="{xaml:Localize Key=Hours}" />
                            </StackPanel>
                            <StackPanel
                                Margin="10,0"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock Style="{StaticResource SecondaryTimeComponentStyle}" Text="{x:Bind ViewModel.Event.MinutesLeft, Mode=OneWay, FallbackValue=00, Converter={StaticResource IntToTimeComponentStringConverter}}" />
                                <TextBlock Style="{StaticResource SecondaryTimeComponentDescriptionStyle}" Text="{xaml:Localize Key=Minutes}" />
                            </StackPanel>
                            <StackPanel
                                Margin="10,0"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock Style="{StaticResource SecondaryTimeComponentStyle}" Text="{x:Bind ViewModel.Event.SecondsLeft, Mode=OneWay, FallbackValue=00, Converter={StaticResource IntToTimeComponentStringConverter}}" />
                                <TextBlock Style="{StaticResource SecondaryTimeComponentDescriptionStyle}" Text="{xaml:Localize Key=Seconds}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Viewbox>
                <TextBlock
                    Margin="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="55"
                    FontWeight="SemiLight"
                    Foreground="White"
                    Text="{x:Bind ViewModel.Event.CelebrationMessage}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.Event.Finished, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                    <TextBlock
                        Grid.Row="1"
                        Margin="20,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        FontSize="40"
                        Foreground="White"
                        Text="{x:Bind ViewModel.Event.Name, Mode=OneWay}" />
                    <TextBlock
                        Margin="22,0,0,20"
                        HorizontalAlignment="Left"
                        FontSize="18"
                        Foreground="White"
                        Opacity="0.8"
                        Text="{x:Bind ViewModel.TargetDateString}" />
                </StackPanel>
            </Grid>
        </Border>

        <Button
            x:Name="BackButton"
            Margin="12"
            Command="{x:Bind ViewModel.GoBackCommand, Mode=OneWay}"
            Style="{StaticResource NavigationBackButtonStyle}"
            ToolTipService.ToolTip="Back"
            Visibility="{x:Bind ViewModel.CanGoBack, Mode=OneWay}" />
        <CommandBar
            Grid.Row="2"
            Grid.ColumnSpan="2"
            ClosedDisplayMode="Compact">
            <AppBarButton Command="{x:Bind ViewModel.Event.ShareCommand}" Label="{xaml:Localize Key=Share}">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE72D;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <!--<AppBarButton
                Command="{x:Bind ViewModel.PinCommand}"
                Icon="Pin"
                Label="{xaml:Localize Key=PinToStart}"
                Visibility="{x:Bind ViewModel.IsTilePinned, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
            <AppBarButton
                Command="{x:Bind ViewModel.UnPinCommand}"
                Icon="UnPin"
                Label="{xaml:Localize Key=UnpinFromStart}"
                Visibility="{x:Bind ViewModel.IsTilePinned, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />-->
            <!--<AppBarButton
                Command="{x:Bind ViewModel.EditCommand}"
                Icon="Edit"
                Label="{xaml:Localize Key=Edit}" />
            <CommandBar.SecondaryCommands>
                <AppBarButton
                    Command="{x:Bind ViewModel.DeletePromptCommand}"
                    Icon="Delete"
                    Label="{xaml:Localize Key=Delete}" />
            </CommandBar.SecondaryCommands>-->
        </CommandBar>
    </Grid>
</local:CountdownDetailViewBase>
