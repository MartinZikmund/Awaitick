<local:MainViewBase
    x:Class="EventCountdowns.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EventCountdowns.Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:EventCountdowns.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:EventCountdowns.Core.Models"
    xmlns:usercontrols="using:EventCountdowns.Controls"
    xmlns:xaml="using:EventCountdowns.Extensions.Xaml"
	xmlns:core="using:Microsoft.Xaml.Interactions.Core"
	xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    mc:Ignorable="d">
    <local:MainViewBase.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition />
        </TransitionCollection>
    </local:MainViewBase.Transitions>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="MobileAdRow" Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="DesktopAdColumn" Width="Auto" />
        </Grid.ColumnDefinitions>
        <usercontrols:PageHeaderControl Title="EVENT COUNTDOWNS" FontWeight="SemiBold" />
        <Button
            Width="48"
            Height="48"
            Margin="12"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            CornerRadius="24">
            <SymbolIcon Symbol="Setting" />
        </Button>
        <Grid Grid.Row="1" Background="Transparent">
			<interactivity:Interaction.Behaviors>
				<core:EventTriggerBehavior EventName="Tapped">
					<core:InvokeCommandAction Command="{x:Bind ViewModel.RootTapCommand}" />
				</core:EventTriggerBehavior>
			</interactivity:Interaction.Behaviors>
			<Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition />
                </TransitionCollection>
            </Grid.ChildrenTransitions>
            <Grid Visibility="{x:Bind ViewModel.HasAnyEvents, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <controls:EventsGridView
                        Name="AdaptiveGridViewControl"
                        ItemTemplate="{StaticResource EventListItemTemplate}"
                        ItemsSource="{x:Bind ViewModel.EventCountdowns}" />
                </Grid>
            </Grid>
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.HasAnyEvents, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                <Image
                    Width="160"
                    Height="160"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Source="ms-appx:///Assets/AddEvent.svg"
                    Stretch="Fill" />
				<TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{xaml:Localize Key=TapToAddYourFirstEvent}" />
            </StackPanel>
        </Grid>

        <!--  Commands  --><!--
        <CommandBar Grid.Row="3" Grid.ColumnSpan="2">
            <AppBarButton
                Command="{x:Bind ViewModel.AddCommand}"
                Icon="Add"
                Label="{xaml:Localize Key=AddEvent}" />
            <AppBarButton
                Command="{x:Bind ViewModel.BuyMeCoffeeCommand}"
                Label="{xaml:Localize Key=BuyMeCoffee}"
                Visibility="{x:Bind ViewModel.ShowCoffee, Converter={StaticResource BoolToVisibilityConverter}}">
                <AppBarButton.Icon>
                    <BitmapIcon
                        Height="25"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        UriSource="/Assets/Icons/Mug.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            --><!--<AppBarButton Icon="Bullets" Label="{xaml:Localize Key=Manage}" />-->
            <!--<AppBarButton Icon="Accept" Click="ButtonBase_OnClick" Label="{xaml:Localize Key=Done}" />--><!--
            <CommandBar.SecondaryCommands>
                <AppBarButton Command="{x:Bind ViewModel.AboutAppCommand}" Label="{xaml:Localize Key=AboutApp}" />
                <AppBarButton Command="{x:Bind ViewModel.RateAppCommand}" Label="{xaml:Localize Key=RateThisApp}" />
                <AppBarButton Command="{x:Bind ViewModel.SendFeedbackCommand}" Label="{xaml:Localize Key=SendFeedback}" />
                <AppBarButton
                    Command="{x:Bind ViewModel.BuyMeCoffeeCommand}"
                    Label="{xaml:Localize Key=BuyMeCoffee}"
                    Visibility="{x:Bind ViewModel.ShowCoffee, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
            </CommandBar.SecondaryCommands>
        </CommandBar>-->
    </Grid>
</local:MainViewBase>
