<local:MainViewBase
    x:Class="EventCountdowns.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EventCountdowns.Core.Controls"
    xmlns:core="using:Microsoft.Xaml.Interactions.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:EventCountdowns.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:EventCountdowns.Core.Models"
    xmlns:usercontrols="using:EventCountdowns.Controls"
    xmlns:xaml="using:EventCountdowns.Extensions.Xaml"
    mc:Ignorable="d">
    <local:MainViewBase.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition />
        </TransitionCollection>
    </local:MainViewBase.Transitions>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="MobileAdRow" Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="DesktopAdColumn" Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="1" Background="Transparent">
            <interactivity:Interaction.Behaviors>
                <core:EventTriggerBehavior EventName="Tapped">
                    <core:InvokeCommandAction Command="{x:Bind ViewModel.RootTapCommand}" />
                </core:EventTriggerBehavior>
            </interactivity:Interaction.Behaviors>
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition />
                </TransitionCollection>
            </Grid.ChildrenTransitions>
            <Grid Padding="12" Visibility="{x:Bind ViewModel.HasAnyEvents, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer HorizontalAlignment="Center" HorizontalContentAlignment="Center">
                    <ItemsView
                        HorizontalAlignment="Center"
                        IsItemInvokedEnabled="True"
						SelectionMode="None"
                        ItemInvoked="ItemsView_ItemInvoked"
                        ItemTemplate="{StaticResource EventListItemTemplate}"
                        ItemsSource="{x:Bind ViewModel.EventCountdowns, Mode=OneTime}">
                        <ItemsView.Layout>
                            <UniformGridLayout
                                ItemsJustification="Center"
                                ItemsStretch="Fill"
                                MaximumRowsOrColumns="3"
                                MinColumnSpacing="20"
                                MinItemHeight="320"
                                MinItemWidth="480"
                                MinRowSpacing="20"
                                Orientation="Horizontal" />
                        </ItemsView.Layout>
                    </ItemsView>
                </ScrollViewer>
            </Grid>

            <StackPanel VerticalAlignment="Center" Visibility="{x:Bind ViewModel.HasAnyEvents, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                <Image Width="120" Source="ms-appx:///Assets/create.png" />
                <TextBlock
                    FontSize="30"
                    Style="{ThemeResource TitleTextBlockStyle}"
                    Text="{xaml:Localize Key=AddYourFirstEvent}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

		<CommandBar Grid.Row="3" Background="{ThemeResource AppOverlayBackgroundBrush}" 
            ClosedDisplayMode="Compact"
            OverflowButtonVisibility="Collapsed">
			<AppBarButton
				Command="{x:Bind ViewModel.GoToGetProCommand}"
				Foreground="Gold"
				Style="{ThemeResource SubtleButtonStyle}"
				Visibility="{x:Bind ViewModel.HasProLicense, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
				<FontIcon Foreground="Gold" Glyph="&#xF133;" />
			</AppBarButton>
			<AppBarButton
                Icon="Add"
				Command="{x:Bind ViewModel.AddCommand}"
                Label="{xaml:Localize Key=Add}"
				ToolTipService.Placement="Top">
				<AppBarButton.KeyboardAccelerators>
					<KeyboardAccelerator Key="N" Modifiers="Control" />
				</AppBarButton.KeyboardAccelerators>
			</AppBarButton>
            <AppBarButton
                Command="{x:Bind ViewModel.GoToSettingsCommand}"
                Icon="Setting"
                Label="{xaml:Localize Key=Settings}" />
        </CommandBar>
    </Grid>
</local:MainViewBase>
