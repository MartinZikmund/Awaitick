<Application
    x:Class="EventCountdowns.CountdownsApp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="using:EventCountdowns.Resources">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  Load WinUI resources  -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///EventCountdowns/Resources/Values.xaml" />
                <ResourceDictionary Source="ms-appx:///EventCountdowns/Resources/Icons.xaml" />
                <ResourceDictionary Source="ms-appx:///EventCountdowns/Resources/Converters.xaml" />
                <ResourceDictionary Source="ms-appx:///EventCountdowns/Resources/Colors.xaml" />
                <ResourceDictionary Source="ms-appx:///EventCountdowns/Resources/Styles.xaml" />
                <resources:DataTemplates />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <!--  Add resources here  -->

</Application>
