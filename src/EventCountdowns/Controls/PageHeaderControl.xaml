<UserControl
    x:Class="EventCountdowns.Controls.PageHeaderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:EventCountdowns.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:Uno.UI.Toolkit"
    d:DesignHeight="100"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid
        x:Name="HeaderGrid"
        toolkit:VisibleBoundsPadding.PaddingMask="Top,Left,Right"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
		<Button x:Name="BackButton"
				Visibility="{x:Bind CanGoBack, Mode=OneWay}"
				Command="{x:Bind GoBackCommand, Mode=OneWay}"
                Style="{StaticResource NavigationBackButtonStyle}"                
                ToolTipService.ToolTip="Back"/>
        <TextBlock
            Margin="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            FontWeight="{x:Bind FontWeight, Mode=OneWay}"
            Style="{ThemeResource TitleTextBlockStyle}"
            Text="{x:Bind Title, Mode=OneWay}"
            TextLineBounds="Tight" />
    </Grid>
</UserControl>
