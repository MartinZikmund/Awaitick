<UserControl
    x:Class="EventCountdowns.Controls.PageHeaderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:EventCountdowns.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:Uno.UI.Toolkit"
	xmlns:xaml="using:EventCountdowns.Extensions.Xaml"
    d:DesignHeight="100"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid
        x:Name="HeaderGrid"
        toolkit:VisibleBoundsPadding.PaddingMask="Top,Left,Right">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button
            Visibility="{x:Bind CanGoBack, Mode=OneWay}"
            ToolTipService.ToolTip="{xaml:Localize Key=Back}"
            Command="{x:Bind GoBackCommand, Mode=OneWay}"
            Style="{ThemeResource NavigationBackButtonStyle}" />
        <TextBlock
            Grid.Column="1"
            FontWeight="{x:Bind FontWeight, Mode=OneWay}"
            Style="{ThemeResource TitleTextBlockStyle}"
            Text="{x:Bind Title, Mode=OneWay}" />
    </Grid>
</UserControl>
