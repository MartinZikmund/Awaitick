<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:EventCountdowns.Converters">
    <converters:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter" />
    <converters:EnumValueToVisibilityConverter x:Key="EnumValueToVisibilityConverter" />
    <converters:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVisibilityConverter" />
    <converters:IntToTimeComponentStringConverter x:Key="IntToTimeComponentStringConverter" />
    <converters:ItemClickEventArgsConverter x:Key="ItemClickEventArgsConverter" />
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <converters:BoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" Inverted="True" />
    <converters:BoolNegationConverter x:Key="BoolNegationConverter" />
    <converters:NonNullToVisibilityConverter x:Key="NonNullToVisibilityConverter" />
    <converters:EnumLocalizationConverter x:Key="EnumLocalizationConverter" />
</ResourceDictionary>
