<ResourceDictionary
    x:Class="EventCountdowns.Resources.DataTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:EventCountdowns.Core.Models"
    xmlns:xaml="using:EventCountdowns.Extensions.Xaml">
    <DataTemplate x:Key="EventGridItemTemplate" x:DataType="models:EventCountdownObservable">
        <UserControl>
            <Grid
                x:Name="MainGrid"
                Width="340"
                Height="210"
                Background="{ThemeResource SystemControlBackgroundAccentBrush}">
                <Border VerticalAlignment="Stretch" Visibility="{x:Bind BackgroundImagePath, Converter={StaticResource EmptyStringToVisibilityConverter}, FallbackValue=Visible}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#00FFFFFF" />
                            <GradientStop Offset="1" Color="#22FFFFFF" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Grid Background="Black" Visibility="{x:Bind BackgroundImagePath, Converter={StaticResource NonEmptyStringToVisibilityConverter}, FallbackValue=Collapsed}">
                    <Image
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0.8"
                        Stretch="UniformToFill">
                        <Image.Source>
                            <Binding Mode="OneTime" Path="BackgroundImagePath">
                                <!--<Binding.TargetNullValue>
                                                <ImageSource>/Assets/SampleBackgrounds/BlankBackground.png</ImageSource>
                                            </Binding.TargetNullValue>-->
                            </Binding>
                        </Image.Source>
                    </Image>
                </Grid>
                <Border Padding="20" VerticalAlignment="Stretch">
                    <Grid>
                        <StackPanel
                            x:Name="CountdownStack"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Orientation="Horizontal"
                            Visibility="{x:Bind Finished, Converter={StaticResource InvertedBoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Visible}">
                            <StackPanel Margin="10,0" Orientation="Vertical">
                                <TextBlock
                                    x:Name="DaysComponent"
                                    Style="{StaticResource TimeComponentStyle}"
                                    Text="{x:Bind DaysLeft, Mode=OneWay, FallbackValue=00, Converter={StaticResource IntToTimeComponentStringConverter}}" />
                                <TextBlock Style="{StaticResource TimeComponentDescriptionStyle}" Text="{xaml:Localize Key=Days}" />
                            </StackPanel>
                            <StackPanel
                                Margin="10,0"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock
                                    x:Name="HoursComponent"
                                    Style="{StaticResource SecondaryTimeComponentStyle}"
                                    Text="{x:Bind HoursLeft, Mode=OneWay, FallbackValue=00, Converter={StaticResource IntToTimeComponentStringConverter}}" />
                                <TextBlock Style="{StaticResource SecondaryTimeComponentDescriptionStyle}" Text="{xaml:Localize Key=Hours}" />
                            </StackPanel>
                            <StackPanel
                                Margin="10,0"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock
                                    x:Name="MinutesComponent"
                                    Style="{StaticResource SecondaryTimeComponentStyle}"
                                    Text="{x:Bind MinutesLeft, Mode=OneWay, FallbackValue=00, Converter={StaticResource IntToTimeComponentStringConverter}}" />
                                <TextBlock Style="{StaticResource SecondaryTimeComponentDescriptionStyle}" Text="{xaml:Localize Key=Minutes}" />
                            </StackPanel>
                            <StackPanel
                                Margin="10,0"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock
                                    x:Name="SecondsComponent"
                                    Style="{StaticResource SecondaryTimeComponentStyle}"
                                    Text="{x:Bind SecondsLeft, Mode=OneWay, FallbackValue=00, Converter={StaticResource IntToTimeComponentStringConverter}}" />
                                <TextBlock Style="{StaticResource SecondaryTimeComponentDescriptionStyle}" Text="{xaml:Localize Key=Seconds}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock
                            Margin="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="35"
                            FontWeight="SemiLight"
                            Foreground="White"
                            Text="{x:Bind CelebrationMessage}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind Finished, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Collapsed}" />
                        <TextBlock
                            Margin="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            FontSize="30"
                            FontWeight="Normal"
                            Foreground="White"
                            Text="{x:Bind Name}"
                            TextLineBounds="Tight" />
                    </Grid>
                </Border>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState>
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="900" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="MainGrid.Width" Value="450" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState>
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1280" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="MainGrid.Width" Value="450" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState>
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1500" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="MainGrid.Width" Value="600" />
                                <Setter Target="MainGrid.Height" Value="300" />
                                <Setter Target="CountdownStack.VerticalAlignment" Value="Center" />
                                <Setter Target="CountdownStack.Margin" Value="0,0,0,0" />
                                <Setter Target="DaysComponent.Style" Value="{StaticResource LargeTimeComponentStyle}" />
                                <Setter Target="HoursComponent.Style" Value="{StaticResource LargeSecondaryTimeComponentStyle}" />
                                <Setter Target="MinutesComponent.Style" Value="{StaticResource LargeSecondaryTimeComponentStyle}" />
                                <Setter Target="SecondsComponent.Style" Value="{StaticResource LargeSecondaryTimeComponentStyle}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            </Grid>
        </UserControl>
    </DataTemplate>

    <DataTemplate x:Key="EventListItemTemplate" x:DataType="models:EventCountdownObservable">
        <UserControl>
            <Grid
                x:Name="MainGrid"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource SystemControlBackgroundAccentBrush}">
                <!--<VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState>
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="400" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="MainGrid.Height" Value="220" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState>
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="550" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="MainGrid.Height" Value="240" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>-->
                <Border VerticalAlignment="Stretch" Visibility="{x:Bind BackgroundImagePath, Converter={StaticResource EmptyStringToVisibilityConverter}, FallbackValue=Visible}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Offset="0" Color="#00FFFFFF" />
                            <GradientStop Offset="1" Color="#22FFFFFF" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Grid Background="Black" Visibility="{x:Bind BackgroundImagePath, Converter={StaticResource NonEmptyStringToVisibilityConverter}, FallbackValue=Collapsed}">
                    <Image
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0.8"
                        Stretch="UniformToFill">
                        <Image.Source>
                            <Binding Mode="OneTime" Path="BackgroundImagePath">
                                <!--<Binding.TargetNullValue>
                                                    <ImageSource>/Assets/SampleBackgrounds/BlankBackground.png</ImageSource>
                                                </Binding.TargetNullValue>-->
                            </Binding>
                        </Image.Source>
                    </Image>
                </Grid>
                <Border Padding="20" VerticalAlignment="Stretch">
                    <Grid>
                        <StackPanel
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Orientation="Horizontal"
                            Visibility="{x:Bind Finished, Converter={StaticResource InvertedBoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Visible}">
                            <StackPanel Margin="10,0" Orientation="Vertical">
                                <TextBlock Style="{StaticResource TimeComponentStyle}" Text="{x:Bind DaysLeft, Mode=OneWay, FallbackValue=00, Converter={StaticResource IntToTimeComponentStringConverter}}" />
                                <TextBlock Style="{StaticResource TimeComponentDescriptionStyle}" Text="{xaml:Localize Key=Days}" />
                            </StackPanel>
                            <StackPanel
                                Margin="10,0"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock Style="{StaticResource SecondaryTimeComponentStyle}" Text="{x:Bind HoursLeft, Mode=OneWay, FallbackValue=00, Converter={StaticResource IntToTimeComponentStringConverter}}" />
                                <TextBlock Style="{StaticResource SecondaryTimeComponentDescriptionStyle}" Text="{xaml:Localize Key=Hours}" />
                            </StackPanel>
                            <StackPanel
                                Margin="10,0"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock Style="{StaticResource SecondaryTimeComponentStyle}" Text="{x:Bind MinutesLeft, Mode=OneWay, FallbackValue=00, Converter={StaticResource IntToTimeComponentStringConverter}}" />
                                <TextBlock Style="{StaticResource SecondaryTimeComponentDescriptionStyle}" Text="{xaml:Localize Key=Minutes}" />
                            </StackPanel>
                            <StackPanel
                                Margin="10,0"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock Style="{StaticResource SecondaryTimeComponentStyle}" Text="{x:Bind SecondsLeft, Mode=OneWay, FallbackValue=00, Converter={StaticResource IntToTimeComponentStringConverter}}" />
                                <TextBlock Style="{StaticResource SecondaryTimeComponentDescriptionStyle}" Text="{xaml:Localize Key=Seconds}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock
                            Margin="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="35"
                            FontWeight="SemiLight"
                            Foreground="White"
                            Text="{x:Bind CelebrationMessage}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind Finished, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Collapsed}" />
                        <TextBlock
                            Margin="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            FontSize="30"
                            FontWeight="Normal"
                            Foreground="White"
                            Text="{x:Bind Name}"
                            TextLineBounds="Tight" />
                    </Grid>
                </Border>
            </Grid>
        </UserControl>
    </DataTemplate>
</ResourceDictionary>
