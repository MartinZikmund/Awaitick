<Page
    x:Class="EventCountdowns.WindowShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="using:EventCountdowns.Extensions.Xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mux="using:Microsoft.UI.Xaml.Controls"
    xmlns:toolkit="using:Uno.UI.Toolkit"
    d:RequestedTheme="Light"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

	<Grid toolkit:VisibleBoundsPadding.PaddingMask="All">
		<Frame x:Name="InnerFrame" />

		<Grid
            x:Name="TitleBarGrid"
            Height="{ThemeResource TitleBarHeight}"
            Padding="0,0"
            VerticalAlignment="Top"
            Background="#11000000"
            ColumnSpacing="8"
            Visibility="{x:Bind HasCustomTitleBar}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<Grid x:Name="DraggableTitleBar" Grid.Column="0" Grid.ColumnSpan="2">
				<StackPanel
					HorizontalAlignment="Center"
					Orientation="Horizontal"
					Spacing="8">
				<Image
					Grid.Column="1"
					Width="16"
					Height="16"
					Source="ms-appx:///Assets/Icons/appicon.png" />
				<TextBlock
					Grid.Column="2"
					VerticalAlignment="Center"
					Style="{ThemeResource CaptionTextBlockStyle}"
					Text="{x:Bind ViewModel.Title}" />
				</StackPanel>
			</Grid>

			<Grid Grid.Column="0" Padding="0,0" Visibility="{x:Bind ViewModel.CanGoBack, Mode=OneWay}">
				<Button
                    x:Name="BackButton"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.GoBackCommand, Mode=OneWay}"
                    Style="{StaticResource NavigationBackButtonStyle}"
                    ToolTipService.ToolTip="Back" />
			</Grid>



		</Grid>
	</Grid>
</Page>
